        "flagsAll": [],
        "flagsNone": [],
        "kind": "button",
        "x": 110,
        "y": 260,
        "width": 570,
        "height": 78,
        "anchor": "top-left",
        "z": 2,
        "visible": true,
        "color": [
          39,
          91,
          106,
          255
        ],
        "texture": "",
        "text": "音を鳴らしてから開始",
        "fontSize": 32,
        "font": "Yu Gothic",
        "bind": "",
        "onClick": [
          {
            "type": "playSound",
            "sound": "audio/confirmation.wav",
            "waitForEnd": true
          },
          {
            "type": "delay",
            "ms": 120
          },
          {
            "type": "setVariable",
            "name": "message",
            "value": "再生終了を確認 → イベント開始"
          },
          {
            "type": "setVisible",
            "target": "after",
            "visible": true
          },
          {
            "type": "emitEvent",
            "name": "title.start"
          }
        ],
        "onChange": [],
        "delayMs": 250,
        "hoverColor": [
          49,
          124,
          140,
          255
        ],
        "pressedColor": [
          37,
          170,
          148,
          255
        ],
        "textColor": [
          242,
          250,
          250,
          255
        ],
        "shadowColor": [
          0,
          0,
          0,
          140
        ],
        "shadowX": 5,
        "shadowY": 6,
        "options": [],
        "selected": ""
      },
      {
        "id": "weather",
        "screen": "title",
        "state": "*",
        "flagsAll": [],
